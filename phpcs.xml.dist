<?xml version="1.0"?>
<ruleset name="WP Antispam">
	<description>WordPress coding, documentation, and security standards for owned plugin source.</description>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<config name="minimum_supported_wp_version" value="6.6"/>
	<config name="testVersion" value="8.2-"/>
	<file>wp-antispam.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<file>templates</file>
	<rule ref="WordPress"/>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="rktsky_antispam"/>
				<element value="Rktsky"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wp-antispam"/>
			</property>
		</properties>
	</rule>
	<!-- Explicit class loader uses PSR-style class filenames. -->
	<rule ref="WordPress.Files.FileName">
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
	</rule>
</ruleset>
